{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-operated-x-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-31",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "APP_ENV": "production",
    "CANDIDATE_TARGET_PER_DAY": "8",
    "AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "X_OAUTH_REDIRECT_URI": "https://ai-operated-x-worker.seiryofes-2027.workers.dev/api/auth/x/callback"
  },
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ai-operated-x-db",
      "database_id": "8df676aa-f1ea-4c33-8e3d-811541e043f7",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["0 1,9,17 * * *"]
  }
}
